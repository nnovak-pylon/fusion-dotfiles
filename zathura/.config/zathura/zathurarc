# Goes dark mode by default
set recolor "true"
# Disables inverstion of content as well
set recolor-reverse-video "true"
# Seems good to have
set recolor-keephue "true"
# Text color
set recolor-darkcolor "#fbf1c7"
# Document color
set recolor-lightcolor "#282828"
# Background
set default-bg "#1d2021"
