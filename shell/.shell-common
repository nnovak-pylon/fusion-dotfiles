# Git aliases
gs() {
  if jj root 2>/dev/null; then
    jj show -s
  else
    git status
  fi
}

# Calculator
alias k="kalker"

# Common shortcuts
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# Class picker
alias c="nli class-list"

# Connect upstream back
alias connect-upstream='git branch --set-upstream-to=origin/$(git branch --show-current) $(git branch --show-current)'
