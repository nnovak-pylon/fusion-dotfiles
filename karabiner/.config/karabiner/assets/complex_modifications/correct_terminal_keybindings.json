{
  "title": "Correct Keybindings in Terminal",
  "maintainers": ["nnovak"],
  "rules": [
    {
      "description": "Remap Control+C as copy unless in terminal",
      "manipulators": [
        {
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": ["^net\\.kovidgoyal\\.kitty$"]
            }
          ],
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": ["control"]
            }
          },
          "to": [
            {
              "key_code": "c",
              "modifiers": ["command"]
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Remap Control+V as paste unless in terminal",
      "manipulators": [
        {
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": ["^net\\.kovidgoyal\\.kitty$"]
            }
          ],
          "from": {
            "key_code": "v",
            "modifiers": {
              "mandatory": ["control"]
            }
          },
          "to": [
            {
              "key_code": "v",
              "modifiers": ["command"]
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
