{
  "title": "More Normal Keybindings",
  "maintainers": ["nnovak"],
  "rules": [
    {
      "description": "Hold down the super key to show open windows",
      "manipulators": [
        {
          "from": {
            "key_code": "left_command"
          },
          "to": [
            {
              "key_code": "left_command",
              "lazy": true
            }
          ],
          "to_if_alone": [
            {
              "key_code": "up_arrow",
              "modifiers": ["control"]
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Use the number keys to switch between tabs",
      "manipulators": [
        {
          "from": {
            "key_code": "1",
            "modifiers": {
              "mandatory": ["left_option"]
            }
          },
          "to": [
            {
              "key_code": "1",
              "modifiers": ["left_command"]
            }
          ],
          "type": "basic"
        },
        {
          "from": {
            "key_code": "2",
